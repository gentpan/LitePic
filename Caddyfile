# LitePic — FrankenPHP / Caddy 参考配置
# ======================================
#
# 推荐：经典模式（每请求独立 boot，等价 Nginx + PHP-FPM）。
# 不要开 worker mode —— LitePic 的配置缓存 / Session 未按常驻内存设计。
#
# 启动示例：
#   frankenphp run --config ./Caddyfile
#   # 或 Docker：
#   docker run --rm -v "$PWD":/app -p 80:80 -p 443:443 \
#     -e SERVER_NAME=img.example.com \
#     dunglas/frankenphp
#
# 环境变量（可选）：
#   SERVER_NAME   监听域名，默认 :8080（本地无 TLS）
#   LITEPIC_ROOT  站点根目录，默认本文件所在目录

{
	frankenphp {
		# 与 .user.ini / nginx-litepic.conf 对齐的上传与内存上限（默认 20MB）
		php_ini {
			upload_max_filesize 20M
			post_max_size 22M
			max_file_uploads 50
			memory_limit 256M
			max_input_time 600
		}
	}

	# 大图上传：读 body 超时放到 10 分钟
	servers {
		timeouts {
			read_body 10m
			read_header 30s
			write 5m
			idle 5m
		}
	}
}

{$SERVER_NAME::8080} {
	root * {$LITEPIC_ROOT:.}
	# /dav 不要压缩：Finder 对 zstd/br 的 PROPFIND 体很脆，空响应被包一层更糟。
	@compressible {
		not path /dav /dav/*
	}
	encode @compressible zstd br gzip
	request_body {
		max_size 22MB
	}

	# 敏感路径与 uploads 下 PHP 禁止访问（对齐 nginx-litepic.conf）
	@denied {
		path /.env* /.git* /.user.ini /data/* /logs/* /app/* /bin/*
		path_regexp php_in_uploads (?i)^/uploads/.*\.php$
	}
	respond @denied 403

	# 静态资源长缓存（图片由 file_server 直出；动态页/API 由 PHP 自己写 no-store）
	#
	# /dav/* 必须排除：WebDAV 里 /dav/相册/foo.jpg 也以 .jpg 结尾，但它是需要
	# Basic 鉴权的私有内容。header 指令会覆盖 PHP 自己写的 no-store，一旦命中就
	# 等于把私密图片标成 public 可缓存一年。
	@static {
		path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.webp *.avif *.woff *.woff2 *.ttf *.eot
		not path /dav /dav/*
	}
	header @static Cache-Control "public, max-age=31536000, immutable"

	# Finder 对 Alt-Svc→HTTP/3 升级经常直接挂掉；清掉广告头。
	header /dav* {
		-Alt-Svc
	}

	# try_files 等价：存在文件则直出，否则落到 index.php（自定义图床前缀依赖此兜底）
	#
	# WebDAV（/dav）不需要额外配置：磁盘上没有 dav 目录，所以 PROPFIND / MKCOL /
	# LOCK 等方法一律走 try_files 兜底到 index.php，再由 index.php dispatch 到
	# dav.php。Caddy 的 fastcgi 会把原始 URI 作为 REQUEST_URI 传进 PHP，因此
	# dav.php 看到的仍是 /dav/... 而不是 /index.php。
	php_server
}
